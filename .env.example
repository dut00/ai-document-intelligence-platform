# Copy to .env and adjust. Values below are for local development only.

# PostgreSQL
POSTGRES_DB=document_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# S3 storage (SeaweedFS). Must match docker/seaweedfs/s3.json.
S3_ACCESS_KEY=local-dev-access-key
S3_SECRET_KEY=local-dev-secret-key
S3_BUCKET=documents

# JWT signing key for the "full" Docker profile (at least 32 characters). Local runs use appsettings.Development.json.
JWT_SIGNING_KEY=local-docker-signing-key-not-for-production-use

# Claude. Leave empty to use the deterministic fake analyzer.
ANTHROPIC_API_KEY=
